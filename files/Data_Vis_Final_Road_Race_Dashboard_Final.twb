    <worksheet name='Race KPI Summary'>
      <layout-options>
        <caption>
          <formatted-text>
            <run fontcolor='#000000' fontname='Benton Sans Book'>This KPI summary compares participation, DNS rate, average pace, and year-over-year growth across race distances and years. The data shows steady growth in participation, especially in the 5K, while performance and DNS trends remain relatively stable with some year-to-year variation. </run>
            <run>Total Registrants (performance_df.csv+ (Multiple Connections)), DNS Rate, Avg Pace (min/mi) and YoY Growth % broken down by Race Year vs. Measure Names and Distance Label. The view is filtered on Distance Label and Race Year. The Distance Label filter keeps 10-Mile and 5K. The Race Year filter keeps 21, 22, 23, 24 and 25.</run>
          </formatted-text>
        </caption>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='participation_df' name='federated.0jg7ced04gvtvm18e27rs0ncnyoo' />
          </datasources>
          <datasource-dependencies datasource='federated.0jg7ced04gvtvm18e27rs0ncnyoo'>
            <column caption='Distance Label' datatype='string' name='[Calculation_2215852964933639]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [distance] = 1 THEN &quot;1K&quot;&#13;&#10;ELSEIF [distance] = 5 THEN &quot;5K&quot;&#13;&#10;ELSE &quot;10-Mile&quot;&#13;&#10;END' />
            </column>
            <column caption='Total Registrants' datatype='integer' name='[Calculation_2215852967178248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT([bib_num])' />
            </column>
            <column caption='DNS Rate' datatype='real' name='[Calculation_2215852967292937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [did_not_start] THEN 1 ELSE 0 END) / COUNT([bib_num])' />
            </column>
            <column caption='Avg Pace (min/mi)' datatype='real' name='[Calculation_2215852967411722]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([pace_sec]) / 60' />
            </column>
            <column caption='YoY Growth %' datatype='real' name='[Calculation_2215852967534603]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(COUNT([bib_num]) - LOOKUP(COUNT([bib_num]), -1)) / ABS(LOOKUP(COUNT([bib_num]), -1))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Bib Num' datatype='integer' name='[bib_num]' role='dimension' type='ordinal' />
            <column caption='Did Not Start' datatype='boolean' name='[did_not_start]' role='dimension' type='nominal' />
            <column caption='Distance' datatype='integer' name='[distance]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_2215852964933639]' derivation='None' name='[none:Calculation_2215852964933639:nk]' pivot='key' type='nominal' />
            <column-instance column='[race_year]' derivation='None' name='[none:race_year:ok]' pivot='key' type='ordinal' />
            <column-instance column='[sex]' derivation='None' name='[none:sex:nk]' pivot='key' type='nominal' />
            <column caption='Pace Sec' datatype='real' name='[pace_sec]' role='measure' type='quantitative' />
